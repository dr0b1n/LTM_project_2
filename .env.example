APP_ENV=development
LOG_LEVEL=INFO

POLICY_DIR=./policies
TELEMETRY_INPUT_DIR=./telemetry/incoming
TELEMETRY_PROCESSED_DIR=./telemetry/processed
TEMPLATE_DIR=./templates
TERRAFORM_OUTPUT_DIR=./output/terraform
REPORT_OUTPUT_DIR=./output/reports

DATABASE_URL=sqlite:///./data/finops.db

DRY_RUN=true
ALLOW_REMEDIATION_EXECUTION=false
REQUIRE_HUMAN_APPROVAL=true

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.1:3b
LLM_TEMPERATURE=0

PROTECTED_ENVIRONMENTS=production,prod,critical
CPU_IDLE_THRESHOLD_PERCENT=3.0
MINIMUM_OBSERVATION_DAYS=14
SNAPSHOT_MAX_AGE_DAYS=90

MAX_REMEDIATIONS_PER_RUN=20
AGENT_RUN_INTERVAL_MINUTES=60