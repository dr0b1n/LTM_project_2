# GENERATED REVIEW-ONLY TERRAFORM PROPOSAL
# Synthetic demonstration. This file declares no cloud resources.
# Human approval is required before any future implementation.

terraform {
  required_version = ">= 1.6.0"
}

locals {
  proposal = {
    finding_id               = {{ finding_id | tojson }}
    resource_id              = {{ resource_id | tojson }}
    cloud_provider           = {{ cloud_provider | tojson }}
    resource_type            = {{ resource_type | tojson }}
    matched_policy           = {{ matched_policy | tojson }}
    recommended_action       = "DOWNSIZE"
    current_monthly_cost     = {{ current_monthly_cost }}
    estimated_monthly_savings = {{ estimated_monthly_savings }}
    currency                 = {{ currency | tojson }}
    reason                   = {{ reason | tojson }}
    dry_run                  = true
    human_approval_required  = true
  }
}

output "review_proposal" {
  description = "Review-only synthetic FinOps downsizing proposal."
  value       = local.proposal
}
